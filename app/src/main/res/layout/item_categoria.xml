<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="24dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvNomeCategoria"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:textColor="@color/keyup_cream"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Redes Sociais" />

    <LinearLayout
        android:id="@+id/caixaCategoria"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/bg_input"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/tvQtdAcessos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/keyup_text_secondary"
            android:textSize="14sp"
            tools:text="5 acessos" />
    </LinearLayout>

</LinearLayout>
