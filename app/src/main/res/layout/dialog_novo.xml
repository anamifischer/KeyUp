<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvTituloNovo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_criar_novo"
            android:textAlignment="center"
            android:textColor="@color/keyup_cream"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_input"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tvToggleAcesso"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_toggle_on"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/toggle_acesso"
                android:textColor="@color/keyup_bg"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvToggleCategoria"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_toggle_off"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/toggle_categoria"
                android:textColor="@color/keyup_cream"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAcesso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/etPlataforma"
                style="@style/KeyUpInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/inpt_plataforma"
                android:importantForAutofill="no" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/lbl_categoria"
                android:textColor="@color/keyup_text_secondary"
                android:textSize="14sp" />

            <Spinner
                android:id="@+id/spCategoria"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_spinner"
                android:paddingStart="16dp"
                android:paddingEnd="44dp"
                android:popupBackground="@color/keyup_surface" />

            <EditText
                android:id="@+id/etAcessoNovo"
                style="@style/KeyUpInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/inpt_acesso"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etSenhaNova"
                style="@style/KeyUpInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/inpt_senha"
                android:importantForAutofill="no"
                android:inputType="textPassword" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="8dp"
                android:text="@string/lbl_nome"
                android:textColor="@color/keyup_text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etNomeCategoria"
                style="@style/KeyUpInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/inpt_nome"
                android:importantForAutofill="no" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSalvar"
            style="@style/KeyUpButtonPrimary"
            android:layout_width="match_parent"
            android:layout_height="47dp"
            android:layout_marginTop="24dp"
            android:text="@string/btn_salvar" />

    </LinearLayout>
</ScrollView>
