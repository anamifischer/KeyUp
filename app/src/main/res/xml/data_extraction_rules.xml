<?xml version="1.0" encoding="utf-8"?>
<!-- o banco nao vai pra nuvem nem pra outro aparelho:
     as senhas ficam criptografadas com uma chave que so existe neste aparelho -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="keyup.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="keyup.db" />
    </device-transfer>
</data-extraction-rules>
