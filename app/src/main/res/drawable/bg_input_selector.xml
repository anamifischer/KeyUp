<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- campo com foco: contorno laranja -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/keyup_surface" />
            <stroke
                android:width="2dp"
                android:color="@color/keyup_orange_light" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- estado normal (sempre por último) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/keyup_surface" />
            <stroke
                android:width="1.5dp"
                android:color="@color/keyup_purple_light" />
            <corners android:radius="14dp" />
        </shape>
    </item>

</selector>